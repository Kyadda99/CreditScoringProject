# Kaggle credentials template. Copy to `.env` and fill in:
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is committed, so keep only placeholders here.
#
# Fill in exactly ONE of the two options below. kagglehub checks them in the
# order given: option A wins if both are set.


# --- Option A: single token -------------------------------------------------
#
# Bearer authentication. No username required. Also accepted as a path to a
# file holding the token.

# KAGGLE_API_TOKEN=


# --- Option B: username + key -----------------------------------------------
#
# HTTP Basic authentication. Both values are required.
# KAGGLE_USERNAME is not a secret; it is the name in your profile URL.
# KAGGLE_KEY comes from https://www.kaggle.com/settings -> "Create New Token".

KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-api-key


# Without `.env`: leave the downloaded `kaggle.json` at ~/.kaggle/kaggle.json.
# kagglehub reads it when neither option A nor B is in the environment.


# Credentials are not enough. Home Credit is a competition, so the rules must
# be accepted in a browser or the API returns 403 even with valid keys:
#   https://www.kaggle.com/competitions/home-credit-default-risk/rules


# --- Scoring service --------------------------------------------------------
#
# Every field has a default, so this section is optional.
#
# CS_MODEL_PATH=models/pipeline.joblib
#
# CS_SCORE_THRESHOLD: unset means the service takes the threshold from the
# artifact, the one the stored metrics were measured at. Set it only to depart
# from that deliberately.
# CS_SCORE_THRESHOLD=0.5
#
# PORT is not read by Settings, which use the CS_ prefix. It is used by
# `cs-serve` and the container CMD; Cloud Run injects it.
# PORT=8080


# --- Training (read by TrainingSettings in src/settings.py) -----------------
#
# All have defaults, so none is required. They control `uv run cs-train`;
# CLI flags take precedence over them.
#
# CS_DATA_PATH=data/raw/application_train.csv
# CS_TEST_SIZE=0.2
# CS_CV_SPLITS=5
# CS_ENGINEERED=true
# CS_TRACK=true
#
# CS_MODELS and CS_ARMS are tuples, so pydantic-settings expects JSON, not a
# comma-separated list:
#
#   CS_MODELS=["xgboost","logistic_regression"]
#   CS_ARMS=["none","class_weight"]
#
# The random seed is not configurable. There is one project seed
# (`config.RANDOM_STATE`); setting it for the split alone would drift from the
# estimators and lie in the artifact metadata.
