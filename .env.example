# Poświadczenia Kaggle — szablon. Skopiuj do `.env` i wypełnij:
#
#     cp .env.example .env
#
# `.env` jest w .gitignore i nigdy nie trafia do repozytorium. Ten plik JEST
# commitowany, więc trzymaj tu wyłącznie placeholdery.
#
# Wypełnij DOKŁADNIE JEDNĄ z dwóch opcji poniżej. `kagglehub` sprawdza je w tej
# samej kolejności, w jakiej są tu opisane — OPCJA A wygrywa, jeśli obie są
# ustawione.


# --- OPCJA A: pojedynczy token (gdy Kaggle dał Ci tylko jedną wartość) -------
#
# Uwierzytelnienie typu Bearer. Nie wymaga nazwy użytkownika.
# Obsługiwane też jako ścieżka do pliku z tokenem — jeśli wartość jest istniejącą
# ścieżką, biblioteka wczyta zawartość pliku zamiast traktować ją jako token.

# KAGGLE_API_TOKEN=


# --- OPCJA B: nazwa użytkownika + klucz (zawartość `kaggle.json`) ------------
#
# Uwierzytelnienie HTTP Basic. Wymaga OBU wartości — sam klucz nie wystarczy.
#
# KAGGLE_USERNAME to NIE jest sekret, tylko Twój login z adresu profilu:
#   https://www.kaggle.com/<tu-jest-twoja-nazwa>
# Nie generuje się go — po prostu go przepisujesz.
#
# KAGGLE_KEY pobierasz z https://www.kaggle.com/settings -> "Create New Token".
# Pobrany plik `kaggle.json` zawiera obie wartości, pod kluczami "username"
# i "key" — wystarczy je stąd przepisać.

KAGGLE_USERNAME=twoja-nazwa-uzytkownika-kaggle
KAGGLE_KEY=twoj-klucz-api


# --- Trzecia droga: bez `.env` ----------------------------------------------
#
# Jeśli wolisz, zostaw pobrany `kaggle.json` w `~/.kaggle/kaggle.json`
# (czyli C:\Users\Lukasz\.kaggle\kaggle.json) i nie wypełniaj nic powyżej.
# `kagglehub` sprawdza ten plik, gdy w środowisku nie ma żadnej z opcji A i B.


# UWAGA — poświadczenia to nie wszystko. Home Credit to KONKURS, więc regulamin
# trzeba zaakceptować w przeglądarce, inaczej API zwróci 403 mimo w pełni
# poprawnych kluczy:
#   https://www.kaggle.com/competitions/home-credit-default-risk/rules


# --- Serwis scoringowy (Faza 1) ---------------------------------------------
#
# Wszystkie pola mają wartości domyślne — ta sekcja jest opcjonalna.
#
# CS_MODEL_PATH=models/pipeline.joblib
#
# CS_SCORE_THRESHOLD — bez ustawienia serwis bierze próg z artefaktu (tego,
# przy którym policzono zapisane metryki). Ustaw tylko po to, żeby świadomie
# od niego odejść.
# CS_SCORE_THRESHOLD=0.5
#
# PORT NIE jest czytany przez Settings (te mają przedrostek CS_). Używają go
# `cs-serve` i CMD kontenera; Cloud Run wstrzykuje go sam.
# PORT=8080
