# The build context must stay small. Without this file the 158 MB CSV and the
# whole .venv would be sent, slowing every build and inflating the layers.
.git/
.venv/
data/
mlruns/
mlflow.db
docs/
notebooks/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
.env
tests/

# models/ is deliberately not excluded: the artifact must enter the image.
